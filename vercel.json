{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.stepheduc.fr"
        }
      ],
      "destination": "https://stepheduc.fr/:path*",
      "permanent": true
    }
  ]
}
